#!/bin/sh
# Only allowed file types reach a commit: no footage, frames, PDFs, data files, binaries, secrets.
root=$(git rev-parse --show-toplevel)
if ! git diff --cached --name-only --no-renames --diff-filter=AMT | sh "$root/scripts/check-files.sh"; then
  echo "Commit blocked. Unstage the files above (git restore --staged <file>); keep them in a git-ignored folder."
  exit 1
fi
