#!/bin/sh
# Blocks a push if any new commit breaks the commit policy (see CONTRIBUTING.md).
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes)
  else
    commits=$(git rev-list "$remote_sha..$local_sha")
  fi
  for c in $commits; do
    sh "$root/scripts/check-commit.sh" "$c" || status=1
  done
done
[ $status -ne 0 ] && echo "Push blocked. Fix the commits above (git commit --amend / git rebase), then push again."
exit $status
